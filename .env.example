# .env.example

NODE_ENV=development
PORT=3000

# Production database
DATABASE_URL=

# Local PostgreSQL
DB_NAME=skillbridge
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=
JWT_EXPIRES_IN=

# AI
GEMINI_API_KEY=

# Aggregated opportunities become stale after this many days without being seen.
OPPORTUNITY_STALE_AFTER_DAYS=14
OPPORTUNITY_SAMPLE_SOURCE=false

# Cloudflare R2 Storage (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=skillbridge-cvs

# Email configuration (Brevo)
BREVO_API_KEY=
MAIL_FROM=




