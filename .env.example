# .env.example

NODE_ENV=development
PORT=5007

# Leave DATABASE_URL empty for local PostgreSQL; use it for hosted databases.
DATABASE_URL=

DB_NAME=skillbridge
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=
JWT_EXPIRES_IN=

OPENAI_API_KEY=

# Aggregated opportunities become stale after this many days without being seen.
OPPORTUNITY_STALE_AFTER_DAYS=14
OPPORTUNITY_SAMPLE_SOURCE=false
