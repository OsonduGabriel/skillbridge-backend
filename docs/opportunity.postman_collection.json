{
  "info": {
    "name": "SkillBridge API",
    "description": "Opportunity and Career Roadmap requests. Set tokens and record IDs locally in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "opportunityId", "value": "" },
    { "key": "roadmapId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "skillGapId", "value": "" }
  ],
  "item": [
    {
      "name": "List and filter opportunities",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/opportunities?page=1&limit=10&type=internship&skill=node.js"
      }
    },
    {
      "name": "Read opportunity",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/opportunities/{{opportunityId}}"
      }
    },
    {
      "name": "Create opportunity",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 201) {",
            "  const body = pm.response.json();",
            "  pm.collectionVariables.set('opportunityId', body.data.id);",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Software Engineering Intern\",\n  \"company\": \"Example Company\",\n  \"description\": \"Build services with the product team.\",\n  \"type\": \"internship\",\n  \"location\": \"Lagos, Nigeria\",\n  \"workMode\": \"hybrid\",\n  \"applicationUrl\": \"https://example.com/careers/intern\",\n  \"requiredSkills\": [\"JavaScript\", \"Node.js\"]\n}"
        },
        "url": "{{baseUrl}}/opportunities"
      }
    },
    {
      "name": "Update opportunity",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"closed\"\n}" },
        "url": "{{baseUrl}}/opportunities/{{opportunityId}}"
      }
    },
    {
      "name": "Aggregate opportunities",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/opportunities/aggregate"
      }
    },
    {
      "name": "Delete opportunity",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/opportunities/{{opportunityId}}"
      }
    },
    {
      "name": "Validation failure example",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/opportunities?page=0"
      }
    },
    {
      "name": "Role failure example",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/opportunities/aggregate"
      }
    },
    {
      "name": "Generate roadmap, provider deferred",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"skillGapId\": \"{{skillGapId}}\"\n}" },
        "url": "{{baseUrl}}/roadmaps/generate"
      }
    },
    {
      "name": "List roadmaps",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/roadmaps"
      }
    },
    {
      "name": "Read roadmap",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}"
      }
    },
    {
      "name": "Update roadmap",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" },
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}"
      }
    },
    {
      "name": "Delete roadmap",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}"
      }
    },
    {
      "name": "Add roadmap task",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"phase\": 30,\n  \"title\": \"Practice SQL joins\",\n  \"description\": \"Complete a relational joins exercise.\",\n  \"taskType\": \"practice\",\n  \"skill\": \"postgresql\"\n}" },
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}/tasks"
      }
    },
    {
      "name": "Update roadmap task status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" },
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "Delete roadmap task",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "Roadmap phase validation failure",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"phase\": 15,\n  \"title\": \"Invalid phase\",\n  \"description\": \"This should fail validation.\",\n  \"taskType\": \"practice\"\n}" },
        "url": "{{baseUrl}}/roadmaps/{{roadmapId}}/tasks"
      }
    }
  ]
}
